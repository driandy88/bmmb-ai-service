# Root .env.example for the bmmb-ai-service monorepo.
# Copy this file to .env and fill in your own values. .env is git-ignored.
#
# This is the union of every env var used across the Python services in
# services/ (aggregation, bbox_generator, chat, extraction, mcp, rag-ingestion,
# validation). Not every service needs every var below -- each one only reads
# what it uses; leave the rest blank/default if you're not running that
# service. aggregation has no configurable env vars of its own.

# ── GCP / Vertex AI (extraction, validation, bbox_generator, chat, rag-ingestion) ──
# Auth is via Application Default Credentials (ADC), not a key in this file.
# One-time local setup (needs the gcloud CLI):
#   gcloud auth application-default login
# On Cloud Run, ADC resolves automatically to the attached service account --
# nothing to configure there beyond IAM roles.
GCP_PROJECT_ID=prototype-bmmb-1b62

# Optional -- defaults to asia-southeast1 (matches Cloud Run region).
VERTEX_LOCATION=asia-southeast1

# ── Environment / API (extraction, chat, rag-ingestion) ──────────────────────
# Which Cloud SQL database templates/attributes are read from: "dev" or
# "prod" -> bmmb_{APP_ENV}. Shared convention across services so they all
# point at the same tables for a given environment.
APP_ENV=dev

# Comma-separated list of allowed frontend origins, or "*" for local dev only.
# (extraction, chat)
ALLOWED_ORIGINS=*

# ── Cloud SQL (PostgreSQL) ────────────────────────────────────────────────────
# Shared by design between extraction, chat, and rag-ingestion -- they all
# point at the SAME Cloud SQL instance. Do not prefix/rename these per
# service; the shared names are intentional.
#
# Required. "project:region:instance", e.g.
#   prototype-bmmb-1b62:asia-southeast1:docs-extractor
# Find it with: gcloud sql instances describe INSTANCE_NAME --format="value(connectionName)"
INSTANCE_CONNECTION_NAME=

# Required. A Postgres user/role created on the instance (see README
# "Cloud SQL setup"). Never commit real credentials -- this file only holds
# placeholders; your actual values live in .env, which is git-ignored.
DB_USER=
DB_PASS=

# Optional -- defaults to bmmb_{APP_ENV} (see APP_ENV above).
# DB_NAME=

# Optional -- set to "true" only if the service has a Serverless VPC Access
# connector attached and the Cloud SQL instance is reachable on its private
# IP. Defaults to "false" (public IP; still TLS-encrypted and IAM-authorized
# via the Cloud SQL connector, no proxy needed). Used by extraction.
# DB_USE_PRIVATE_IP=false

# rag-ingestion and chat's PgVectorRetriever (RAG_BACKEND=pgvector) connect
# over host:port instead of the connector -- local dev via the
# cloud-sql-proxy (127.0.0.1:5433 for rag-ingestion), prod via the Cloud SQL
# private IP.
# DB_HOST=127.0.0.1
# DB_PORT=5433

# Connection via extraction's/chat's Cloud SQL Python Connector authorizes
# using the same Application Default Credentials as GCP_PROJECT_ID above
# (the connecting principal needs the "Cloud SQL Client" IAM role) -- nothing
# extra to configure there.

# ── extraction service ────────────────────────────────────────────────────────
# Required for write access. Guards POST/PUT/DELETE on /templates and
# /attributes -- callers must send it as the X-Admin-Key header. GET
# endpoints and /extract are unauthenticated and unaffected by this.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Stored in Secret Manager as "extraction-admin-key" for Cloud Run.
ADMIN_API_KEY=

# ── validation service ────────────────────────────────────────────────────────
VALIDATION_AI_MODEL=gemini-2.5-flash
VALIDATION_AI_MAX_RETRIES=2
VALIDATION_AI_RETRY_BACKOFF_SECONDS=1.0

# ── bbox_generator service ────────────────────────────────────────────────────
# Optional -- how close (normalized page-fraction distance) an LLM-guessed
# bbox must be to a text-layer candidate to snap to it. Defaults to 0.18.
# BBOX_SNAP_RADIUS=0.18

# ── chat service ──────────────────────────────────────────────────────────────
# Full details, including all backend switches, live in services/chat/.env.example.
# Leave GCP_PROJECT_ID empty to run fully offline: LLM_BACKEND defaults to
# `stub` (deterministic NLU) and everything still works end-to-end.
LLM_BACKEND=stub            # vertex | stub
RAG_BACKEND=stub            # stub | vertex | pgvector
AUDIT_BACKEND=memory        # none | memory | cloudsql   (memory = redacted records in RAM only)
SESSION_STORE_BACKEND=none  # none | memory | postgres   (none = fully stateless; server keeps nothing)
EXTRACTION_BACKEND=stub     # stub | http   (http calls the extraction service for document uploads)

# The separate services/extraction microservice (POST /extract). stub = canned.
EXTRACTION_SERVICE_URL=     # e.g. https://extraction-xxxx.asia-southeast1.run.app

MODEL_ID=gemini-2.5-flash

# Routing / memory
CONFIDENCE_THRESHOLD=0.7    # Sheet 9.4 -- tune on the example query bank
HISTORY_MAX_TURNS=10        # server re-trims client history to this
HISTORY_MAX_CHARS=6000

# Content placeholders (BMMB to supply)
NEW_APPLICATION_URL=https://apply.muamalat.example/sme/new
HANDOFF_HOURS=Mon-Fri, 9:00am-5:00pm

# ── RAG retrieval (chat's RAG_BACKEND=pgvector; also rag-ingestion) ──────────
# EMBEDDING_MODEL_ID / EMBEDDING_DIMENSIONS are shared -- must match the
# ingested vectors, so keep chat and rag-ingestion in sync.
EMBEDDING_MODEL_ID=gemini-embedding-001   # MUST match the ingested vectors
EMBEDDING_DIMENSIONS=1536

# chat-side retrieval tuning (PgVectorRetriever)
RAG_HYBRID_CANDIDATES=20    # per leg (dense + keyword), pre-fusion
RAG_RERANK_TOP_N=5
RAG_RRF_K=60
RAG_RELEVANCE_FLOOR=0.58    # below this best cosine -> abstain (honest handoff)

# ── rag-ingestion pipeline ────────────────────────────────────────────────────
# Stage-1 vision transcription model. Confirm the current id at build time --
# do not assume a version that has been superseded.
VISION_MODEL_ID=gemini-2.5-pro
# Query-rewrite + RAGAS judge model. Must be STRONGER than the answer
# generator to avoid self-preference bias.
JUDGE_MODEL_ID=gemini-2.5-pro

EMBED_BATCH_SIZE=50
GCS_SOURCES_BUCKET=bmmb-rag-sources

# Parsing + automated verification
PARSE_DPI=150
# Table / numeric-dense pages are re-rendered at this higher DPI: no JPEG
# compression artifacts on small figures like `2,540 kg` or `0.75%`.
PARSE_DPI_TABLES=300
# A page with >= this many Pass-B facts (or a table) is transcribed twice at
# temperature 0 and its numbers diffed.
SELF_CONSISTENCY_MIN_FACTS=3
# products.yaml (the workbook quantum table) is owned by the chat service;
# the cross-check reads it there rather than duplicating the numbers. Path is
# resolved relative to the service root (services/rag-ingestion/).
PRODUCTS_YAML=../chat/app/config/products.yaml

# Chunking (tables never split)
CHUNK_TARGET_MIN_TOKENS=300
CHUNK_TARGET_MAX_TOKENS=800
CHUNK_CEILING_TOKENS=1000
CHUNK_MERGE_BELOW_TOKENS=50

# Retrieval (consumed by the chat-side PgVectorRetriever)
RETRIEVAL_TOP_K=20   # per method, pre-fusion
RERANK_TOP_N=5
# Below this fused score the retriever returns EMPTY so the agent abstains
# honestly and offers a Sales handoff. Tune against the eval set.
RELEVANCE_FLOOR=0.5
HNSW_EF_SEARCH=40

# Root for the inspectable per-stage artifacts (00_raw ... 05_enriched).
RAG_DATA_DIR=data

# ── mcp (Gmail agent) -- alternate auth path ──────────────────────────────────
# The mcp service does NOT use ADC/Vertex like the services above. It talks to
# Gemini directly via langchain-google-genai (needs a Gemini API key, not ADC)
# and sends mail via a Gmail App Password -- a genuinely different auth
# mechanism, not a duplicate of GCP_PROJECT_ID/ADC.
GOOGLE_API_KEY=
SENDER_EMAIL=
APP_PASSWORD=
