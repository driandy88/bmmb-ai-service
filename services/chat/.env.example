# Copy to `.env` for local dev. Never commit real secrets — in prod these come
# from Secret Manager -> Cloud Run env vars.

APP_ENV=dev

# ── Backend switches ─────────────────────────────────────────────────────────
# Leave GCP_PROJECT_ID empty to run fully offline: LLM_BACKEND defaults to
# `stub` (deterministic NLU) and everything still works end-to-end.
LLM_BACKEND=stub            # vertex | stub
RAG_BACKEND=stub            # stub | vertex | pgvector
AUDIT_BACKEND=memory        # none | memory | cloudsql   (memory = redacted records in RAM only)
SESSION_STORE_BACKEND=none  # none | memory | postgres   (none = fully stateless; server keeps nothing)
EXTRACTION_BACKEND=stub     # stub | http   (http calls the extraction service for document uploads)

# ── Document extraction service (only when EXTRACTION_BACKEND=http) ───────────
# The separate services/extraction microservice (POST /extract). stub = canned.
EXTRACTION_SERVICE_URL=     # e.g. https://extraction-xxxx.asia-southeast1.run.app

# ── Vertex AI / Gemini (only needed when LLM_BACKEND=vertex) ─────────────────
# Auth is ADC: `gcloud auth application-default login` locally, attached
# service account on Cloud Run. No API keys.
GCP_PROJECT_ID=prototype-bmmb-1b62
VERTEX_LOCATION=asia-southeast1
MODEL_ID=gemini-2.5-flash

# ── Routing / memory ─────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7    # Sheet 9.4 — tune on the example query bank
HISTORY_MAX_TURNS=10        # server re-trims client history to this
HISTORY_MAX_CHARS=6000

# ── Content placeholders (BMMB to supply) ────────────────────────────────────
NEW_APPLICATION_URL=https://apply.muamalat.example/sme/new
HANDOFF_HOURS=Mon–Fri, 9:00am–5:00pm

# ── API ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── Cloud SQL (only when *_BACKEND point at postgres/cloudsql/pgvector) ──────
# The SME platform instance. RAG reads/writes the SHARED `bmmb` database.
INSTANCE_CONNECTION_NAME=prototype-bmmb-1b62:asia-southeast1:bmmb
DB_USER=postgres
DB_PASS=                    # Secret Manager: extraction-db-pass
DB_NAME=
DB_USE_PRIVATE_IP=false

# ── RAG: ingestion + retrieval (see docs/RAG_PLAN.md) ────────────────────────
RAG_DB_NAME=bmmb            # vector store lives here, in rag_* tables
# RAG_DB_URL — set to bypass the Cloud SQL connector (local docker/CI). Note
# that dotenv reads `KEY=   # note` as the comment text, so keep notes on
# their own line for values meant to be blank.
RAG_DB_URL=

# vertex = Vertex AI embeddings, ADC auth (deployed default)
# hf     = Hugging Face Inference API, needs HF_TOKEN (no torch, no weights)
# hash   = deterministic offline vectors, no credentials (tests)
RAG_EMBEDDING_PROVIDER=hash

# Required only when RAG_EMBEDDING_PROVIDER=hf. A secret — Secret Manager in
# prod. https://huggingface.co/settings/tokens (needs inference permission).
HF_TOKEN=
# Blank = the provider's default: gemini-embedding-001 (vertex) or
# intfloat/multilingual-e5-large (hf). Both produce 1024-d vectors, so the two
# providers share one column and can be swapped without a migration.
RAG_EMBEDDING_MODEL=
# MUST match both the model's output width and the vector(N) column:
#   intfloat/multilingual-e5-large -> 1024 (native)
#   gemini-embedding-001           -> 1024 (truncated from 3072, re-normalised)
# 1024 rather than gemini's usual 768 because the smaller multilingual e5 sizes
# are not served for feature-extraction by HF's inference providers.
# Changing it after ingest means re-applying the DDL and re-ingesting.
RAG_EMBEDDING_DIM=1024

# `simple` = no stemming. Deliberate: the corpus mixes Bahasa Malaysia and
# English, and the `english` stemmer mangles Malay tokens.
RAG_FTS_CONFIG=simple

# Chunking (approximate tokens — see ingestion/chunker.py).
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_CHUNK_MIN_TOKENS=40     # smaller chunks get folded into a neighbour

# Retrieval widths: fetch CANDIDATE_K per arm, return TOP_K after fusion.
RAG_TOP_K=5
RAG_CANDIDATE_K=40
